#!/bin/bash -e

(
    flock -n 9

    # Raspbian keeps the original file names, other platforms get a suffix
    PLATFORM=$(onefinity-platform 2>/dev/null || echo raspbian-armhf)
    SUFFIX=
    [ "$PLATFORM" != "raspbian-armhf" ] && SUFFIX=-$PLATFORM

    RELEASE_URL=https://raw.githubusercontent.com/OneFinityCNC/onefinity-release/master
    VERSION=$(curl -s $RELEASE_URL/latest$SUFFIX.txt)
    PKG_NAME=onefinity-$VERSION$SUFFIX
    PKG=/var/lib/bbctrl/firmware/update.tar.bz2
    PKG_URL=$RELEASE_URL/$PKG_NAME.tar.bz2

    logger Installing onefinity firmware $VERSION

    cd /var/lib/bbctrl
    mkdir -p firmware

    echo Downloading $PKG_URL
    curl -s $PKG_URL > $PKG

    /usr/local/bin/update-bbctrl

    echo Success

    logger bbctrl firmware $VERSION installed

) 9> /var/lock/bbctrl.upgrade.lock
