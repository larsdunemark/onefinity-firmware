#!/bin/bash

# Runs inside cage (see onefinity-kiosk.service).  Replaces xinitrc and
# scripts/browser from the Raspbian X11 setup.

URL=${URL:-http://localhost/}
BOOT_DIR=/boot
[ -e /boot/firmware/config.txt ] && BOOT_DIR=/boot/firmware
BOOT_DIR=${TEST_BOOT_DIR:-$BOOT_DIR}

# Wait up to 60s for bbctrl so the browser doesn't open on an error page
for _ in $(seq 60); do
    curl -s -o /dev/null --max-time 1 "$URL" && break
    sleep 1
done

# The web UI stores screen rotation as display_rotate in config.txt, which
# the legacy firmware framebuffer used.  Under KMS, apply it to the outputs.
# wlroots rotates touch input along with the output it is mapped to.
ROTATE=$(sed -n 's/^display_rotate[[:space:]]*=[[:space:]]*\([0-9]\).*/\1/p' \
             $BOOT_DIR/config.txt 2>/dev/null | tail -1)
case "$ROTATE" in
    1) TRANSFORM=90 ;;
    2) TRANSFORM=180 ;;
    3) TRANSFORM=270 ;;
    *) TRANSFORM=normal ;;
esac

for OUTPUT in $(wlr-randr | grep -o '^[^[:space:]]\+'); do
    wlr-randr --output "$OUTPUT" --transform $TRANSFORM
done

# Clear the crash flags so Chromium doesn't offer to restore the session
for PREFS in ~/snap/chromium/common/chromium/Default/Preferences \
             ~/.config/chromium/Default/Preferences; do
    [ -e "$PREFS" ] || continue
    sed -i 's/"exited_cleanly":false/"exited_cleanly":true/' "$PREFS"
    sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/' "$PREFS"
done

exec chromium --kiosk --ozone-platform=wayland --no-first-run \
     --noerrdialogs --disable-infobars --hide-crash-restore-bubble \
     --disable-3d-apis --password-store=basic \
     --check-for-update-interval=31536000 "$URL"
